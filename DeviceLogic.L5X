<!--Process the logic for each device with index and indirect addressing.-->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="32.02" TargetName="DeviceLogic" TargetType="Routine" TargetSubType="RLL" ContainsContext="true" ExportDate="Wed Sep 23 12:02:02 2026" ExportOptions="References NoRawData L5KData DecoratedData Context Dependencies ForceProtectedEncoding AllProjDocTrans">
<Controller Use="Context" Name="Transcat_L33ER">
<DataTypes Use="Context">
<DataType Name="Device" Family="NoFamily" Class="User">
<Description>
<![CDATA[this UDT will be the template for all equipment / devices - feeders, flow meters, others and will be set up for each device to be indexed and processed via indirect addressing]]>
</Description>
