</Tag>
<Tag Name="dNum" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[The index of the current device being processed]]>
</Description>
<Data Format="L5K">
<![CDATA[14]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="14"/>
</Data>
</Tag>
<Tag Name="HMI_AllReset" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bit to reset Auto/Man, AutoRun, RecipeRun, TimedRunEnable to 0 from HMI]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="HMI_AutoStart" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Starts all devices in AUTO]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="HMI_AutoStop" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Stops all devices in AUTO]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="HMI_RecipeStart" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bit to start and stop recipe from HMI]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="RecipeStart" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bit to start and stop a recipe execution from PLC logic]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="StartBeepTimer" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Timer to sound the beep alarm before starting a device]]>
</Description>
<Data Format="L5K">
<![CDATA[[2149896,2500,0]]]>
</Data>
<Data Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="2500"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</Data>
</Tag>
<Tag Name="TestBit1" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Just a test bit - does not do anything]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
</Tags>
<Programs Use="Context">
<Program Use="Context" Name="MainProgram">
<Tags Use="Context">
<Tag Name="MX101_Clr_VFd_Faults" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bit to clear VFD faults]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
</Tags>
<Routines Use="Context">
<Routine Use="Target" Name="DeviceLogic" Type="RLL">
<Description>
<![CDATA[Process the logic for each device with index and indirect addressing.]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Convert the start delay time to milliseconds]]>
</Comment>
<Text>
<![CDATA[MUL(Device[dNum].StartDelayms,1000,Device[dNum].StartDelay.PRE);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Convert the timed run target time to milliseconds]]>
</Comment>
<Text>
<![CDATA[MUL(Device[dNum].TimedRunTarget,1000,Device[dNum].TimedRunTargetms);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Auto mode selected for device]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].HMI_AutoSelect)[OTL(Device[dNum].AutoMan) ,OTU(Device[dNum].ManualRun) ,OTU(Device[dNum].AutoArmed) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Auto mode selected for device]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].HMI_ManualSelect)[OTU(Device[dNum].AutoMan) ,[OTU(Device[dNum].ManualRun) ,OTU(Device[dNum].AutoArmed) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[arms a device only when you issue a fresh global Auto Start:]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_AutoStart)XIC(Device[dNum].AutoMan)OTL(Device[dNum].AutoArmed);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Manual Start Logic]]>
</Comment>
<Text>
<![CDATA[XIO(Device[dNum].AutoMan)XIC(Device[dNum].HMI_ManualStart)XIC(Device[dNum].PermissivesMan)XIO(Device[dNum].Interlock)XIC(AllDeviceEnable)OTL(Device[dNum].ManualRun);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(Device[dNum].HMI_ManualStop) ,[XIC(Device[dNum].AutoMan) ,[XIC(Device[dNum].Interlock) ,[XIO(Device[dNum].PermissivesMan) ,XIO(AllDeviceEnable) ] ] ] ]OTU(Device[dNum].ManualRun);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(AutoActive)XIC(Device[dNum].AutoMan)XIC(Device[dNum].AutoArmed)XIO(Auto_Run_All_Interlock)OTE(Device[dNum].AutoRun);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[clear AutoArmed whenever the automatic run is deliberately terminated or faulted.]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_AutoStop) ,[XIC(HMI_AllReset) ,XIC(Auto_Run_All_Interlock) ] ]OTU(Device[dNum].AutoArmed);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(Device[dNum].AutoMan) XIC(Device[dNum].AutoRun) ,XIO(Device[dNum].AutoMan) XIC(Device[dNum].ManualRun) ]OTE(Device[dNum].RunRequest);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[This logic controls the run / stop for FT103 when running in Auto and Manual]]>
</Comment>
<Text>
<![CDATA[[XIC(Device[dNum].AutoMan) XIC(Device[dNum].AutoRun) XIC(Device[dNum].PermissivesAuto) ,XIO(Device[dNum].AutoMan) XIC(Device[dNum].ManualRun) XIC(Device[dNum].PermissivesMan) ]XIC(StartBeepTimer.DN)TON(Device[dNum].StartDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(alwaysOFF)XIC(HMI_RecipeStart)ONS(Device[dNum].OneShots[3])OTL(Device[dNum].AutoRun);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(alwaysOFF)XIO(HMI_RecipeStart)ONS(Device[dNum].OneShots[4])OTU(Device[dNum].AutoRun);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Start device and reset and start the  device cycle timer, run campaign timer and total timer]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].StartDelay.DN)[XIC(AllDeviceEnable) XIO(Device[dNum].Interlock) OTE(Device[dNum].Output) ,[RTO(Device[dNum].CycleTime,?,?) RTO(Device[dNum].TotalTime,?,?) ,ONS(Device[dNum].OneShots[0]) RES(Device[dNum].CycleTime) ] ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[If any device in placed into manaul run - set the AnyManualRun bit to trigger pre-start beep]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].ManualRun)[OTL(AnyManualRun) ,OTL(AnyManRunFlag) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[If any device in placed into Auto run - set the AnyManualRun bit to trigger pre-start beep]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].AutoRun)[OTL(AnyAutoRun) ,OTL(AnyAutoRunFlag) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Timed Run or Campaing Time Run Logic - Logic to clear Campaign Timer on timed run enable and increment the campaign (Camp) timer when the device in running a timed run]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].TimeRunEnable)[ONS(Device[dNum].OneShots[1]) OTL(Device[dNum].AutoMan) RES(Device[dNum].CampTime) ,XIC(Device[dNum].Output) RTO(Device[dNum].CampTime,?,?) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Timed Run or Campaing Time Run Logic - if campaign timer greater than target or timed run bit off - stop the timed run logic and reset all to manual and idle]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].TimeRunEnable)GRT(Device[dNum].CampTime.ACC,Device[dNum].TimedRunTargetms)ONS(RecipeStart)OTE(AllReset);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Interlock all devices running in  Auto Run and Turn then off when an interlcok from any other device running in Auto Run is triggered]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].AutoRun)XIC(Device[dNum].AutoMan)XIC(Auto_Run_All_Interlock)OTU(Device[dNum].AutoRun);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Reset AutoMan, AutoRun, TimeRunEnable, and HIMI_ReceipStart on PLC or HMI All_Rest]]>
</Comment>
<Text>
<![CDATA[[XIC(AllReset) ,XIC(HMI_AllReset) ][OTU(Device[dNum].AutoMan) OTU(Device[dNum].AutoRun) OTU(Device[dNum].ManualRun) ,OTU(Device[dNum].TimeRunEnable) OTU(HMI_RecipeStart) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Reset All Reset and HMI All Rest after scanning all devices]]>
</Comment>
<Text>
<![CDATA[XIC(alwaysOFF)OTU(AllReset);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(alwaysOFF)OTE(TestBit1);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(MX101_Clr_VFd_Faults)OTE(MX101_UpperHowesVFD:O.ClearFaults);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
