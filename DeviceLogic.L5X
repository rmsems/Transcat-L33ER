<Description>
<![CDATA[Delay after Auto RUNNING before device starts]]>
</Description>
</Member>
<Member Name="RunType" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[0=Open, 1=Timed, 2=Amount]]>
