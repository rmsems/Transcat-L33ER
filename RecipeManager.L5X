</Tag>
<Tag Name="AllCampaignDevicesComplete" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[True when all devices selected in the active recipe that require automatic completion have reached their campaign target.]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="RecipeAnyDeviceSelected" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[True when at least one device is selected for automatic operation in the active recipe.]]>
</Description>
<Data Format="L5K">
<![CDATA[1]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="1"/>
</Data>
</Tag>
<Tag Name="RecipeParametersValid" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[True when all selected devices contain valid recipe operating parameters.]]>
</Description>
<Data Format="L5K">
<![CDATA[1]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="1"/>
</Data>
</Tag>
<Tag Name="rNum" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Index used by RecipeManager to process active recipe device parameters.]]>
</Description>
<Data Format="L5K">
<![CDATA[15]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="15"/>
</Data>
</Tag>
</Tags>
<Programs Use="Context">
<Program Use="Context" Name="MainProgram">
<Routines Use="Context">
<Routine Use="Reference" Name="RecipeDeviceLogic">
</Routine>
<Routine Use="Target" Name="RecipeManager" Type="RLL">
<Description>
<![CDATA[validated and prepares ActiveRecipe]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Recipe Validation Initialization — Clears the device-selected result and initializes parameter validation true before evaluating all active recipe devices.]]>
</Comment>
<Text>
<![CDATA[[OTU(RecipeAnyDeviceSelected) ,OTL(RecipeParametersValid) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Campaign Completion Initialization — Assume all target-based recipe devices are complete before scanning the active recipe. RecipeDeviceLogic clears this status if any selected device has not reached its campaign target.]]>
</Comment>
<Text>
<![CDATA[OTL(AllCampaignDevicesComplete);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Active Recipe Device Processing — Executes RecipeDeviceLogic once for each active device to evaluate recipe selection and validate device recipe parameters.]]>
</Comment>
<Text>
<![CDATA[FOR(RecipeDeviceLogic,rNum,0,14,1);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Active Recipe Validation — Sets the active recipe valid when it has a valid RecipeID, at least one device selected for Auto, and all selected device parameters pass validation.]]>
</Comment>
<Text>
<![CDATA[GRT(ActiveRecipe.RecipeID,0)XIC(RecipeAnyDeviceSelected)XIC(RecipeParametersValid)OTE(ActiveRecipe.Valid);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
