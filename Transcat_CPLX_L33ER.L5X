<Routines>
<Routine Name="Logic" Type="ST">
<Description>
<![CDATA[Converts 8-byte ASCII hex string (e.g. BF61F4AA) to REAL float]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// ================================================]]>
</Line>
<Line Number="1">
<![CDATA[// HexASCII_to_REAL AOI Logic - Structured Text]]>
</Line>
<Line Number="2">
<![CDATA[// Converts 8 ASCII hex bytes → IEEE 754 REAL]]>
</Line>
<Line Number="3">
<![CDATA[// ================================================]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[Error := 0;]]>
</Line>
<Line Number="6">
<![CDATA[TempDINT := 0;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[// Parse each of the 8 hex characters]]>
</Line>
<Line Number="9">
<![CDATA[FOR i := 0 TO 7 DO]]>
</Line>
<Line Number="10">
<![CDATA[    TempByte := HexIn[i];]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[    IF (TempByte >= 48) AND (TempByte <= 57) THEN          // '0' - '9']]>
</Line>
<Line Number="13">
<![CDATA[        Nibble := TempByte - 48;]]>
</Line>
<Line Number="14">
<![CDATA[    ELSIF (TempByte >= 65) AND (TempByte <= 70) THEN       // 'A' - 'F' uppercase]]>
</Line>
<Line Number="15">
<![CDATA[        Nibble := TempByte - 55;]]>
</Line>
<Line Number="16">
<![CDATA[    ELSIF (TempByte >= 97) AND (TempByte <= 102) THEN      // 'a' - 'f' lowercase]]>
</Line>
<Line Number="17">
<![CDATA[        Nibble := TempByte - 87;]]>
</Line>
<Line Number="18">
<![CDATA[    ELSE]]>
</Line>
<Line Number="19">
<![CDATA[        Error := 1;          // Invalid character]]>
</Line>
<Line Number="20">
<![CDATA[        FloatOut := 0.0;]]>
</Line>
<Line Number="21">
<![CDATA[        EXIT;                // Break out of FOR loop early]]>
</Line>
<Line Number="22">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[    // Build the 32-bit pattern (most-significant digit first)]]>
</Line>
<Line Number="25">
<![CDATA[    TempDINT := (TempDINT * 16) + Nibble;]]>
</Line>
<Line Number="26">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[// Only perform COP if no error occurred]]>
</Line>
<Line Number="29">
<![CDATA[IF NOT Error THEN]]>
</Line>
<Line Number="30">
<![CDATA[    COP(TempDINT, FloatOut, 1);]]>
</Line>
<Line Number="31">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
