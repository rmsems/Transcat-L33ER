<Routines>
<Routine Name="AutoControl" Type="RLL">
<Description>
<![CDATA[Place where Auto device control logic lives]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(HMI_AutoStart)ONS(AutoStartOS)OTL(AutoActive);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(HMI_AutoStop)ONS(AutoStopOS)OTU(AutoActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="BronkDataMapping" Type="ST">
<Description>
<![CDATA[Map FT UDT elements to data to/from Bronkhorst Anybus Gateway]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[FT103.AlarmID := Anybus_ETH_SER:I.Data[200];]]>
</Line>
<Line Number="1">
<![CDATA[FT104.AlarmID := Anybus_ETH_SER:I.Data[201];]]>
</Line>
<Line Number="2">
<![CDATA[FT105.AlarmID := Anybus_ETH_SER:I.Data[202];]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[FT103.PV_R := BronkRealInArr[0];]]>
</Line>
<Line Number="5">
<![CDATA[FT103.TempC := BronkRealInArr[1];]]>
</Line>
<Line Number="6">
<![CDATA[FT103.Density := BronkRealInArr[2];]]>
</Line>
<Line Number="7">
<![CDATA[FT103.SP_R := BronkRealInArr[3];]]>
</Line>
<Line Number="8">
<![CDATA[FT103.Totalizer := BronkRealInArr[4];]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[FT104.PV_R := BronkRealInArr[5];]]>
</Line>
<Line Number="11">
<![CDATA[FT104.TempC := BronkRealInArr[6];]]>
</Line>
<Line Number="12">
<![CDATA[FT104.Density := BronkRealInArr[7];]]>
</Line>
<Line Number="13">
<![CDATA[FT104.SP_R := BronkRealInArr[8];]]>
</Line>
<Line Number="14">
<![CDATA[FT104.Totalizer := BronkRealInArr[9];]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[FT105.PV_R := BronkRealInArr[10];]]>
</Line>
<Line Number="17">
<![CDATA[FT105.TempC := BronkRealInArr[11];]]>
</Line>
<Line Number="18">
<![CDATA[FT105.Density := BronkRealInArr[12];]]>
</Line>
<Line Number="19">
<![CDATA[FT105.SP_R := BronkRealInArr[13];]]>
</Line>
<Line Number="20">
<![CDATA[FT105.Totalizer := BronkRealInArr[14];]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[FT103.OT_R := (BronkOutArr[0]) / 167681.5;]]>
</Line>
<Line Number="23">
<![CDATA[FT104.OT_R := (BronkOutArr[1]) / 167681.5;]]>
</Line>
<Line Number="24">
<![CDATA[FT105.OT_R := (BronkOutArr[2]) / 167681.5;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Bronkhorst_Data" Type="RLL">
<Description>
<![CDATA[read and write data to/from the EIP instance and convert to/from 8 byte to/from floating point]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[One 1st scan set dataIndex (index/pointer) to 4 (1st for 4 Bytes from Anybus are NOT process data)]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)[MOV(4,dataIndex) ,MOV(0,resultIndex) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[CPT(dataIndex,resultIndex*8+4);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[write the current input array into a an array for use in the AOI - we have room for 50 data values from Anybys/Bronkhorst ]]>
</Comment>
<Text>
<![CDATA[COP(Anybus_ETH_SER:I.Data[dataIndex],TempHexIn[0],8);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[AOI to convert the 8 AsciiHex Bytes to Real - one 8 byte group at a time]]>
</Comment>
<Text>
<![CDATA[XIC(NewDataToggle)HexASCII_to_REAL(AcsiiToReal1,TempHexIn,ConvertedFloat,ConversionError);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[MOV(ConvertedFloat,bronkhorstReal[resultIndex]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[increment index by one]]>
</Comment>
<Text>
<![CDATA[ADD(resultIndex,1,resultIndex);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Reset the device index when max device number is reached.  If AnyManRunFlag or AnyAutoRunFlag is not set - unlatch the corresponding AnyManualRun or AnyAutoRun bits - this is all for pre-start beep control (so the system only beeps when something is starting, not each time a new device starts) - Also resets Run Flags for next iteration through devices]]>
</Comment>
<Text>
<![CDATA[GRT(resultIndex,48)MOV(0,resultIndex);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Copy  4 DINT (BYTES) coming in through  Anybus into Real Registers - Endian ness is set int he annybus (swap  byte and swap word)
Only copy 15 real values = 60 sints addresses (4 - 63) - these are 5 real values (rate, temp density, setpoint, total) x 3 Flow meters = 15 real values]]>
</Comment>
<Text>
<![CDATA[COP(Anybus_ETH_SER:I.Data[4],BronkRealInArr[0],15);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Copy  4 DINT (BYTES) coming in through  Anybus into Real Registers - Endian ness is set int he annybus (swap  byte and swap word)
Only copy 3 long in  = 9  sints addresses (starting at 64 ) - these are 3 long ints are the outpunt 0 - 100 = 0 - 32000  for 3 Flow meters]]>
</Comment>
<Text>
<![CDATA[COP(Anybus_ETH_SER:I.Data[64],BronkOutArr[0],3);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Write FT103 setpoint (Float) to 4 sint Anybyus regsiters for transfer to Bronkhorst]]>
</Comment>
<Text>
<![CDATA[COP(FT103.SP_W,Anybus_ETH_SER:O.Data[52],4);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Write FT104 setpoint (Float) to 4 sint Anybyus regsiters for transfer to Bronkhorst]]>
</Comment>
<Text>
<![CDATA[COP(FT104.SP_W,Anybus_ETH_SER:O.Data[56],4);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Write FT105 setpoint (Float) to 4 sint Anybyus regsiters for transfer to Bronkhorst]]>
</Comment>
<Text>
<![CDATA[COP(FT105.SP_W,Anybus_ETH_SER:O.Data[60],4);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="DeviceLogic" Type="RLL">
<Description>
<![CDATA[Process the logic for each device with index and indirect addressing.]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Convert the start delay time to milliseconds]]>
</Comment>
<Text>
<![CDATA[MUL(Device[dNum].StartDelayms,1000,Device[dNum].StartDelay.PRE);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Convert the timed run target time to milliseconds]]>
</Comment>
<Text>
<![CDATA[MUL(Device[dNum].TimedRunTarget,1000,Device[dNum].TimedRunTargetms);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Auto mode selected for device]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].HMI_AutoSelect)[OTL(Device[dNum].AutoMan) ,OTU(Device[dNum].ManualRun) ,OTU(Device[dNum].AutoArmed) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Auto mode selected for device]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].HMI_ManualSelect)[OTU(Device[dNum].AutoMan) ,[OTU(Device[dNum].ManualRun) ,OTU(Device[dNum].AutoArmed) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[arms a device only when you issue a fresh global Auto Start:]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_AutoStart)XIC(Device[dNum].AutoMan)OTL(Device[dNum].AutoArmed);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[sets all interlocks when any estop active]]>
</Comment>
<Text>
<![CDATA[XIC(EstopActive)[OTL(Device[dNum].Interlock) ,OTL(EStopResetRequired) ,MOV(10,Device[dNum].InterlockID) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Reset all device interlocks from the reset button the on the VFD panel (EstopResetPulse) when no E-stop is active]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_InterlockResetAll) ,XIC(EStopResetPulse) ]XIO(EstopActive)[OTU(EStopResetRequired) ,MOV(0,Device[dNum].InterlockID) ,OTU(Device[dNum].Interlock) ,OTE(MX101_UpperHowesVFD:O.ClearFaults) ,OTE(MX201_LowerHowesVFD:O.ClearFaults) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Manual Start Logic]]>
</Comment>
<Text>
<![CDATA[XIO(Device[dNum].AutoMan)XIC(Device[dNum].HMI_ManualStart)XIC(Device[dNum].PermissivesMan)XIO(Device[dNum].Interlock)XIC(AllDeviceEnable)OTL(Device[dNum].ManualRun);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(Device[dNum].HMI_ManualStop) ,[XIC(Device[dNum].AutoMan) ,[XIC(Device[dNum].Interlock) ,[XIO(Device[dNum].PermissivesMan) ,XIO(AllDeviceEnable) ] ] ] ]OTU(Device[dNum].ManualRun);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(AutoActive)XIC(Device[dNum].AutoMan)XIC(Device[dNum].AutoArmed)XIO(Auto_Run_All_Interlock)OTE(Device[dNum].AutoRun);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[clear AutoArmed whenever the automatic run is deliberately terminated or faulted.]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_AutoStop) ,[XIC(HMI_AllReset) ,XIC(Auto_Run_All_Interlock) ] ]OTU(Device[dNum].AutoArmed);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(Device[dNum].AutoMan) XIC(Device[dNum].AutoRun) ,XIO(Device[dNum].AutoMan) XIC(Device[dNum].ManualRun) ]OTE(Device[dNum].RunRequest);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[This logic controls the run / stop for FT103 when running in Auto and Manual]]>
</Comment>
<Text>
<![CDATA[[XIC(Device[dNum].AutoMan) XIC(Device[dNum].AutoRun) XIC(Device[dNum].PermissivesAuto) ,XIO(Device[dNum].AutoMan) XIC(Device[dNum].ManualRun) XIC(Device[dNum].PermissivesMan) ]XIC(StartBeepTimer.DN)TON(Device[dNum].StartDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(alwaysOFF)XIC(HMI_RecipeStart)ONS(Device[dNum].OneShots[3])OTL(Device[dNum].AutoRun);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(alwaysOFF)XIO(HMI_RecipeStart)ONS(Device[dNum].OneShots[4])OTU(Device[dNum].AutoRun);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Start device and reset and start the  device cycle timer, run campaign timer and total timer]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].StartDelay.DN)[XIC(AllDeviceEnable) XIO(Device[dNum].Interlock) OTE(Device[dNum].Output) ,[RTO(Device[dNum].CycleTime,?,?) RTO(Device[dNum].TotalTime,?,?) ,ONS(Device[dNum].OneShots[0]) RES(Device[dNum].CycleTime) ] ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[If any device in placed into manaul run - set the AnyManualRun bit to trigger pre-start beep]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].ManualRun)[OTL(AnyManualRun) ,OTL(AnyManRunFlag) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[If any device in placed into Auto run - set the AnyManualRun bit to trigger pre-start beep]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].AutoRun)[OTL(AnyAutoRun) ,OTL(AnyAutoRunFlag) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Timed Run or Campaing Time Run Logic - Logic to clear Campaign Timer on timed run enable and increment the campaign (Camp) timer when the device in running a timed run]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].TimeRunEnable)[ONS(Device[dNum].OneShots[1]) OTL(Device[dNum].AutoMan) RES(Device[dNum].CampTime) ,XIC(Device[dNum].Output) RTO(Device[dNum].CampTime,?,?) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Timed Run or Campaing Time Run Logic - if campaign timer greater than target or timed run bit off - stop the timed run logic and reset all to manual and idle]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].TimeRunEnable)GRT(Device[dNum].CampTime.ACC,Device[dNum].TimedRunTargetms)ONS(RecipeStart)OTE(AllReset);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Interlock all devices running in  Auto Run and Turn then off when an interlcok from any other device running in Auto Run is triggered]]>
</Comment>
<Text>
<![CDATA[XIC(Device[dNum].AutoRun)XIC(Device[dNum].AutoMan)XIC(Auto_Run_All_Interlock)OTU(Device[dNum].AutoRun);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Reset AutoMan, AutoRun, TimeRunEnable, and HIMI_ReceipStart on PLC or HMI All_Rest]]>
</Comment>
<Text>
<![CDATA[[XIC(AllReset) ,XIC(HMI_AllReset) ][OTU(Device[dNum].AutoMan) OTU(Device[dNum].AutoRun) OTU(Device[dNum].ManualRun) ,OTU(Device[dNum].TimeRunEnable) OTU(HMI_RecipeStart) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Reset All Reset and HMI All Rest after scanning all devices]]>
</Comment>
<Text>
<![CDATA[XIC(alwaysOFF)OTU(AllReset);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(alwaysOFF)OTE(TestBit1);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(MX101_Clr_VFd_Faults)OTE(MX101_UpperHowesVFD:O.ClearFaults);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="DeviceManager" Type="RLL">
<Description>
<![CDATA[Loop through all devices each scan]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[clear the temporary scan flags:]]>
</Comment>
<Text>
<![CDATA[[OTU(AnyManRunFlag) ,OTU(AnyAutoRunFlag) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[This for loop call Device Logic 14 times (0 - 13) so each device is processed once per PLC scan
]]>
</Comment>
<Text>
<![CDATA[FOR(DeviceLogic,dNum,0,13,1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Pre-Beep Manual Start behaviour flag rest - If AnyManRunFlag or AnyAutoRunFlag is not set - unlatch the corresponding AnyManualRun or AnyAutoRun bits - this is all for pre-start beep control (so the system only beeps when something is starting, not each time a new device starts) - 
]]>
</Comment>
<Text>
<![CDATA[XIO(AnyManRunFlag)OTU(AnyManualRun);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Pre-Beep Auto
 Start behaviour flag rest If AnyManRunFlag or AnyAutoRunFlag is not set - unlatch the corresponding AnyManualRun or AnyAutoRun bits - this is all for pre-start beep control (so the system only beeps when something is starting, not each time a new device starts) - 
]]>
</Comment>
<Text>
<![CDATA[XIO(AnyAutoRunFlag)OTU(AnyAutoRun);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="GF201Dose" Type="RLL">
<Description>
<![CDATA[Logic to Dose a specific amount from GF201 - Thayer 2]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Legacy / inactive — revisit when we design recipe or batch dosing behavior.
Reset Thayer 2 Totalizer 1 on Dose Start or Total Reset from HMI]]>
</Comment>
<Text>
<![CDATA[[XIC(DoseStart) ,[XIC(Thayer2ResetTotal1_HMI) ,XIC(DiscreteTemp) ] ]ONS(DoseStartOneShot)OTE(GF201_Write_Total1Reset);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[When totalizer set to 0, start feeder]]>
</Comment>
<Text>
<![CDATA[EQU(GF201_Totalizer1,0)ONS(DoseStartOneShot)[OTL(Device[3].AutoMan) ,OTL(Device[3].AutoRun) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[when totalizer is greater than or equal to the target weight or when stop button pushed, stop the feeder. Advance the counter by 1]]>
</Comment>
<Text>
<![CDATA[[GEQ(GF201_Totalizer1,DoseTarget) ,XIC(DoseStop) ]ONS(DoseStopOneShot)[OTU(Device[3].AutoMan) ,[OTU(Device[3].AutoRun) ,CTU(DoseCounter,?,?) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(DoseCounterReset_HMI)RES(DoseCounter);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Initialize" Type="RLL">
<Description>
<![CDATA[Reset controls and any other initialization required]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[One 1st scan set DeviceNum (index/pointer) and AllDevice1stScanDone bit to 0.]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)[MOV(0,InitCount) ,OTU(AllDevice1stScanDone) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Reset (unlatch) AutoMan (place in Manual), AutoRun (Place in Auto Stop), and ManualRun (Place in Manual Stop) - add other device resets here. this will reset all devices in the 1st 10 scans  as there are currenlty only 10 devices (0 - 9).  If more are added, there is room for up to 20 devices in the code]]>
</Comment>
<Text>
<![CDATA[XIO(AllDevice1stScanDone)[OTU(Device[InitCount].AutoMan) ,[OTU(Device[InitCount].AutoRun) ,OTU(Device[InitCount].ManualRun) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[If InitCount < # of devices, increment index by one]]>
</Comment>
<Text>
<![CDATA[LES(InitCount,10)ADD(InitCount,1,InitCount);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[When all devices (10) scanned - set AllDevices1stScanDone Bit so intitialization of bits ends]]>
</Comment>
<Text>
<![CDATA[GEQ(InitCount,10)OTL(AllDevice1stScanDone);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="InterlockLogic" Type="RLL">
<Description>
<![CDATA[All interlock logic is handled here]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(VFD_Panel_Safety_Panel_Etop_OK) ,XIO(VFD_Panel_Safety_Remote_Estops_OK) ]OTE(EstopActive);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(MX101.LidInterlock) ,XIC(MX101.DevErrorInterlock) ,XIC(MX101.VFDCommsIntlk) ,XIC(MX101.VFDFaultIntlk) ,XIC(MX101.VFDNotReadyIntlk) ]OTL(Device[0].Interlock);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Device[0].HMI_DeviceReset)[OTU(MX101.LidInterlock) ,OTU(MX101.DevErrorInterlock) ,OTU(MX101.VFDCommsIntlk) ,OTU(MX101.VFDFaultIntlk) ,OTU(MX101.VFDNotReadyIntlk) ,OTU(Device[0].Interlock) ,MOV(0,Device[0].InterlockID) ,OTE(MX101_UpperHowesVFD:O.ClearFaults) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(MX201.LidInterlock) ,XIC(MX201.DevErrorInterlock) ,XIC(MX201.VFDCommsIntlk) ,XIC(MX201.VFDFaultIntlk) ,XIC(MX201.VFDNotReadyIntlk) ]OTL(Device[1].Interlock);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Device[1].HMI_DeviceReset)[OTU(MX201.LidInterlock) ,OTU(MX201.DevErrorInterlock) ,OTU(MX201.VFDCommsIntlk) ,OTU(MX201.VFDFaultIntlk) ,OTU(MX201.VFDNotReadyIntlk) ,OTU(Device[1].Interlock) ,MOV(0,Device[1].InterlockID) ,OTE(MX201_LowerHowesVFD:O.ClearFaults) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(GF101.ExcessDevInterlock) ,XIC(GF101.VFDCommsIntlk) ,XIC(GF101.VFDFaultIntlk) ,XIC(GF101.VFDNotReadyIntlk) ]OTL(Device[2].Interlock);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Clear the Excess Dev Interlock and Write Ack to GF101 Feeder Controller to reset it (clear the local alarm bit)]]>
</Comment>
<Text>
<![CDATA[XIC(Device[2].HMI_DeviceReset)[OTU(GF101.ExcessDevInterlock) ,OTE(GF101_Write_Acknowledge) ,OTU(GF101.VFDCommsIntlk) ,OTU(GF101.VFDFaultIntlk) ,OTU(GF101.VFDNotReadyIntlk) ,OTU(Device[2].Interlock) ,MOV(0,Device[2].InterlockID) ,OTE(GF101_Limestone_Feeder:O.ClearFaults) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(GF201.ExcessDevInterlock) ,XIC(GF201.VFDCommsIntlk) ,XIC(GF201.VFDFaultIntlk) ,XIC(GF201.VFDNotReadyIntlk) ]OTL(Device[3].Interlock);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Clear the Excess Dev Interlock and Write Ack to GF101 Feeder Controller to reset it (clear the local alarm bit)]]>
</Comment>
<Text>
<![CDATA[XIC(Device[3].HMI_DeviceReset)[OTU(GF201.ExcessDevInterlock) ,OTE(GF201_Write_Acknowledge) ,OTU(GF201.VFDCommsIntlk) ,OTU(GF201.VFDFaultIntlk) ,OTU(GF201.VFDNotReadyIntlk) ,OTU(Device[3].Interlock) ,MOV(0,Device[3].InterlockID) ,OTE(GF201_Bentonite_Feeder:O.ClearFaults) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(VF101.VFDCommsIntlk) ,XIC(VF101.VFDCommsIntlk) ,XIC(VF101.VFDNotReadyIntlk) ]OTL(Device[5].Interlock);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Clear the Excess Dev Interlock and Write Ack to GF101 Feeder Controller to reset it (clear the local alarm bit)]]>
</Comment>
<Text>
<![CDATA[XIC(Device[5].HMI_DeviceReset)[MOV(0,Device[5].InterlockID) ,OTU(VF101.VFDCommsIntlk) ,OTU(VF101.VFDFaultIntlk) ,OTU(VF101.VFDNotReadyIntlk) ,OTU(Device[5].Interlock) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(VF201.VFDCommsIntlk) ,XIC(VF201.VFDFaultIntlk) ,XIC(VF201.VFDNotReadyIntlk) ]OTL(Device[6].Interlock);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Clear the Excess Dev Interlock and Write Ack to GF101 Feeder Controller to reset it (clear the local alarm bit)]]>
</Comment>
<Text>
<![CDATA[XIC(Device[6].HMI_DeviceReset)[MOV(0,Device[6].InterlockID) ,OTU(VF201.VFDCommsIntlk) ,OTU(VF201.VFDFaultIntlk) ,OTU(VF201.VFDNotReadyIntlk) ,OTU(Device[6].Interlock) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[FT103 High Pressure or Alarm Interlock — Always interlocks FT103. If FT103 is actively running in Auto, also interlocks the Auto process.]]>
</Comment>
<Text>
<![CDATA[[XIC(FT103B.HighPressureInterlock) ,XIC(FT103B.Alarm) ]OTL(Device[7].Interlock);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[FT104 High Pressure or Alarm Interlock — Always interlocks FT104. If FT104 is actively running in Auto, also interlocks the Auto process.]]>
</Comment>
<Text>
<![CDATA[[XIC(FT104B.HighPressureInterlock) ,XIC(FT104B.Alarm) ]OTL(Device[8].Interlock);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[FT105 High Pressure or Alarm Interlock — Always interlocks FT105. If FT105 is actively running in Auto, also interlocks the Auto process.]]>
</Comment>
<Text>
<![CDATA[[XIC(FT105B.HighPressureInterlock) ,XIC(FT105B.Alarm) ]OTL(Device[9].Interlock);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Unlatch  Auto_Run_All_Interlock on HMI reset]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_AllReset)[OTU(Auto_Run_All_Interlock) ,[OTU(Device[7].Interlock) ,[OTU(Device[8].Interlock) ,OTU(Device[9].Interlock) ] ] ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Reset FT103 Pressure Interlock and Device Interlock if  and if Pressure and alarm at ok
]]>
</Comment>
<Text>
<![CDATA[XIC(Device[7].HMI_DeviceReset)LEQ(PT103_PV_RAW,FT103B.HighPressureLimit_Int)OTU(FT103B.HighPressureInterlock)XIO(FT103B.Alarm)[OTU(Device[7].Interlock) ,MOV(0,Device[7].InterlockID) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Reset FT104 Pressure Interlock and Device Interlock if  and if Pressure and alarm at ok]]>
</Comment>
<Text>
<![CDATA[XIC(Device[8].HMI_DeviceReset)LEQ(PT104_PV_RAW,FT104B.HighPressureLimit_Int)OTU(FT104B.HighPressureInterlock)XIO(FT104B.Alarm)[OTU(Device[8].Interlock) ,MOV(0,Device[8].InterlockID) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Reset FT104 Pressure Interlock and Device Interlock if  and if Pressure and alarm at ok
]]>
</Comment>
<Text>
<![CDATA[XIC(Device[9].HMI_DeviceReset)LEQ(PT105_PV_RAW,FT105B.HighPressureLimit_Int)OTU(FT105B.HighPressureInterlock)XIO(FT105B.Alarm)[OTU(Device[9].Interlock) ,MOV(0,Device[9].InterlockID) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(HMI_ProcessReset)XIO(AnyDeviceInterlock)OTU(Auto_Run_All_Interlock);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[[XIC(Device[0].Interlock) ,XIC(Device[1].Interlock) ,XIC(Device[2].Interlock) ,XIC(Device[3].Interlock) ,XIC(Device[4].Interlock) ,XIC(Device[5].Interlock) ,XIC(Device[6].Interlock) ,XIC(Device[7].Interlock) ,XIC(Device[8].Interlock) ,XIC(Device[9].Interlock) ,XIC(Device[10].Interlock) ,XIC(Device[11].Interlock) ,XIC(Device[12].Interlock) ,XIC(Device[13].Interlock) ]OTE(AnyDeviceInterlock);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[[XIC(Device[0].AutoMan) XIC(Device[0].Interlock) ,XIC(Device[1].AutoMan) XIC(Device[1].Interlock) ,XIC(Device[2].AutoMan) XIC(Device[2].Interlock) ,XIC(Device[3].AutoMan) XIC(Device[3].Interlock) ,XIC(Device[4].AutoMan) XIC(Device[4].Interlock) ,XIC(Device[5].AutoMan) XIC(Device[5].Interlock) ,XIC(Device[6].AutoMan) XIC(Device[6].Interlock) ,XIC(Device[7].AutoMan) XIC(Device[7].Interlock) ,XIC(Device[8].AutoMan) XIC(Device[8].Interlock) ,XIC(Device[9].AutoMan) XIC(Device[9].Interlock) ,XIC(Device[10].AutoMan) XIC(Device[10].Interlock) ,XIC(Device[11].AutoMan) XIC(Device[11].Interlock) ,XIC(Device[12].AutoMan) XIC(Device[12].Interlock) ,XIC(Device[13].AutoMan) XIC(Device[13].Interlock) ]OTE(AnyAutoDeviceInterlock);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(AnyAutoDeviceInterlock)OTL(Auto_Run_All_Interlock);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Arm reset]]>
</Comment>
<Text>
<![CDATA[XIC(VFD_Panel_Safety_WaitingForReset)OTL(EStopResetArmed);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Generate pulse when Banner accepts reset]]>
</Comment>
<Text>
<![CDATA[XIC(EStopResetArmed)XIO(VFD_Panel_Safety_WaitingForReset)ONS(EStopReset_OS)OTE(EStopResetPulse);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Disarm]]>
</Comment>
<Text>
<![CDATA[XIC(EStopResetPulse)[OTU(EStopResetArmed) ,OTE(MX101_UpperHowesVFD:O.ClearFaults) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Light_Beacon" Type="RLL">
<Description>
<![CDATA[Indicator Light Beacon]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(MX101_UpperHowesVFD:O.Stop)XIC(MX201_LowerHowesVFD:O.Stop)OTE(BeaconRedLight);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(YellowFlashOff.DN)[XIC(MX101_UpperHowesVFD:I.Faulted) ,XIC(MX201_LowerHowesVFD:I.Faulted) ]TON(YellowFlashOn,?,?)OTE(BeaconYellowLight);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(YellowFlashOn.DN)[XIC(MX101_UpperHowesVFD:I.Faulted) ,XIC(MX201_LowerHowesVFD:I.Faulted) ]TON(YellowFlashOff,?,?)OTE(BeaconYellowLight);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(MX101_UpperHowesVFD:I.Ready) XIO(MX101_UpperHowesVFD:I.Active) ,XIC(MX201_LowerHowesVFD:I.Ready) XIO(MX201_LowerHowesVFD:I.Active) ]OTE(BeaconGreenLight);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(MX201_LowerHowesVFD:I.Active)XIO(MX101_UpperHowesVFD:I.Active)[XIC(MX201_LowerHowesVFD:I.Active) ,XIC(MX101_UpperHowesVFD:I.Active) ]TON(GreenFlashingOn,?,?)OTE(BeaconGreenLight);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(GreenFlashingOn.DN)TON(GreenFlashingOff,?,?)OTE(BeaconGreenLight);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(MX101.AutoRun) ,XIC(MX201.AutoRun) ]OTL(BeaconBlueLight);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(MX101.ManualRun) ,XIC(MX201.ManualRun) ]OTU(BeaconBlueLight);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(AnyManualRun) ,XIC(AnyAutoRun) ][TON(StartBeepTimer,?,?) ,XIO(StartBeepTimer.DN) OTE(Beep) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Beep)OTE(BeepNew);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(Light_Beacon,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(GF101.Enable)JSR(_02_GF101_Thayer1_WB_Feeder,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(GF201.Enable)JSR(_03_GF201_Thayer2_WB_Feeder,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[NEQ(MSG_FROM_SLC500[1],MX101_UpperHowesVFD:O.FreqCommand)MOV(MSG_FROM_SLC500[1],UpperHowesSpeed);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(FT103.Enable)JSR(_07_FT103_Oil_Dosing,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
