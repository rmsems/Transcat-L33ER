<Tag Name="GF301_Command_Bits" TagType="Base" DataType="INT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Command Word - Holds a value that gets written to Acrison SCB2000:I.Data[15]  see Acrison Manual for which bits do what]]>
</Description>
<Comments>
<Comment Operand=".0">
<![CDATA[Run-1 / Stop-0]]>
</Comment>
<Comment Operand=".1">
<![CDATA[Refill Mode Man - 1 / Auto - 0]]>
</Comment>
<Comment Operand=".2">
<![CDATA[Batch-1 / Cont-0]]>
</Comment>
<Comment Operand=".3">
<![CDATA[Batch Abort]]>
</Comment>
<Comment Operand=".4">
<![CDATA[Refill ON]]>
</Comment>
<Comment Operand=".5">
<![CDATA[Refill OFF]]>
</Comment>
<Comment Operand=".6">
<![CDATA[Alarm Ack]]>
</Comment>
<Comment Operand=".7">
<![CDATA[Mode Vol - 1/ Grav - 0]]>
</Comment>
<Comment Operand=".8">
<![CDATA[Setpoint - Ext -1 / Int - 0]]>
</Comment>
</Comments>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
