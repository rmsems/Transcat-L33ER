</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(alwaysOFF)JSR(DeviceLogic,0);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(VF101.Enable)JSR(_05_VF101_Medium_Feeder,0);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(VF201.Enable)JSR(_06_VF201_Small_Feeder_2,0);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(alwaysOFF)JSR(GF201Dose,0);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[JSR(Initialize,0);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[JSR(_11_Auxillary_Pump_AE,0);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[JSR(_12_SC_1_Screener,0);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[JSR(Safety_Hoist_Beacons,0);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[JSR(_13_CV101_3_Way_Dosing_Value,0);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[JSR(InterlockLogic,0);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[JSR(Bronkhorst_Data,0);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[JSR(BronkDataMapping,0);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[JSR(AutoControl,0);]]>
</Text>
