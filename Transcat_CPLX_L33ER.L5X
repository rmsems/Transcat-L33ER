<![CDATA[Bribble]]>
</Comment>
<Comment Operand=".INT_STATUS.8">
<![CDATA[High Level]]>
</Comment>
<Comment Operand=".INT_STATUS.9">
<![CDATA[Low Level]]>
</Comment>
<Comment Operand=".INT_STATUS.10">
<![CDATA[Overfill / Empty]]>
</Comment>
<Comment Operand=".INT_STATUS.11">
<![CDATA[Alarm]]>
</Comment>
<Comment Operand=".INT_STATUS.12">
<![CDATA[Message]]>
</Comment>
<Comment Operand=".INT_STATUS.13">
<![CDATA[Empty]]>
</Comment>
<Comment Operand=".INT_STATUS.14">
<![CDATA[Overfill]]>
</Comment>
<Comment Operand=".INT_STATUS.15">
<![CDATA[Acrilock]]>
</Comment>
<Comment Operand=".INT_STATUS.16">
<![CDATA[No Scale]]>
