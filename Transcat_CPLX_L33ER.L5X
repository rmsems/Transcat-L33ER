<Routine Name="_11_Auxillary_Pump_AE" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Device[11].Output)OTE(TC_Remote_IO:4:O.0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[OTE(Device[11].PermissivesAuto) ,OTE(Device[11].PermissivesMan) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Reset interlock on all system reset]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_AllReset)OTU(Device[11].Interlock);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_12_SC_1_Screener" Type="RLL">
<Description>
<![CDATA[Screener]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[If output is on energize the ouput and  start / run the screener]]>
</Comment>
<Text>
<![CDATA[XIC(Device[12].Output)OTE(VFD9_Screener:O.Start);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[If output is off - de- energize the ouput and  stop the screener]]>
</Comment>
<Text>
<![CDATA[XIO(Device[12].Output)OTE(VFD9_Screener:O.Stop);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Set the speed of the screener to 60 Hz]]>
</Comment>
<Text>
<![CDATA[CPT(VFD9_Screener:O.FreqCommand,6000);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[OTE(Device[12].PermissivesAuto) ,OTE(Device[12].PermissivesMan) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Reset interlock on all system reset]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_AllReset)[OTU(Device[12].Interlock) ,OTE(VFD9_Screener:O.ClearFaults) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_13_CV101_3_Way_Dosing_Value" Type="RLL">
<Description>
<![CDATA[3 way valve to switch between recyle and feed to process]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[If output is on energize the ouput and  place the 3 way valve in Process (feed liquid to the process), If ouput is off - de-energize the output and place  the 3 way valve in Recycle (feed liquid back to tank - recycle)]]>
</Comment>
<Text>
<![CDATA[XIC(Device[13].Output)OTE(CV_101_Output);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[OTE(Device[13].PermissivesAuto) ,OTE(Device[13].PermissivesMan) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Reset interlock on all system reset]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_AllReset)OTU(Device[13].Interlock);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
<CST MasterID="0"/>
<WallClockTime LocalTimeAdjustment="0" TimeZone="0"/>
<Trends/>
<DataLogs/>
<TimeSynchronize Priority1="128" Priority2="128" PTPEnable="false"/>
<EthernetPorts>
<EthernetPort Port="1" Label="1" PortEnabled="true"/>
<EthernetPort Port="2" Label="2" PortEnabled="true"/>
</EthernetPorts>
<EthernetNetwork SupervisorModeEnabled="false" SupervisorPrecedence="0" BeaconInterval="400" BeaconTimeout="1960" VLANID="0"/>
</Controller>
