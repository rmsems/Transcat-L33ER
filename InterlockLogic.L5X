<DataType Name="Acrison_Feeder" Family="NoFamily" Class="User">
<Description>
<![CDATA[Acrison Feeder Tags]]>
</Description>
<Members>
<Member Name="ZZZZZZZZZZAcrison_Fe0" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/>
<Member Name="AutoMan" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZAcrison_Fe0" BitNumber="0" ExternalAccess="Read/Write">
<Description>
<![CDATA[On  - Auto Control - follows AutoRun bit,  Off - Manaul Control - follows Manual Run bit]]>
</Description>
</Member>
<Member Name="ManualRun" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZAcrison_Fe0" BitNumber="1" ExternalAccess="Read/Write">
<Description>
<![CDATA[On - Runs feeder in Manual, Off - Stops feeder in manual]]>
</Description>
</Member>
