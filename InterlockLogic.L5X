<Tag Name="VFD_Panel_Safety_Panel_Etop_OK" TagType="Alias" Radix="Decimal" AliasFor="XS26_VFD_Cabinet_Safety_Controller:I1.Data[1].6" ExternalAccess="Read/Write"/>
<Tag Name="VFD_Panel_Safety_Remote_Estops_OK" TagType="Alias" Radix="Decimal" AliasFor="XS26_VFD_Cabinet_Safety_Controller:I1.Data[1].7" ExternalAccess="Read/Write"/>
<Tag Name="VFD_Panel_Safety_WaitingForReset" TagType="Alias" Radix="Decimal" AliasFor="XS26_VFD_Cabinet_Safety_Controller:I1.Data[1].5" ExternalAccess="Read/Write"/>
</Tags>
<Programs Use="Context">
<Program Use="Context" Name="MainProgram">
<Routines Use="Context">
<Routine Use="Target" Name="InterlockLogic" Type="RLL">
<Description>
<![CDATA[All interlock logic is handled here]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(VFD_Panel_Safety_Panel_Etop_OK) ,XIO(VFD_Panel_Safety_Remote_Estops_OK) ]OTE(EstopActive);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[MX101 Interlock Summary — Sets Device[0].Interlock while any MX101 interlock cause is active.]]>
</Comment>
<Text>
<![CDATA[[XIC(MX101.LidInterlock) ,XIC(MX101.DevErrorInterlock) ,XIC(MX101.VFDCommsIntlk) ,XIC(MX101.VFDFaultIntlk) ]OTE(Device[0].Interlock);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[MX101 Interlock ID Priority — Assigns the highest-priority active interlock: Lid Safety 11, VFD Communications 20, VFD Fault 21, VFD Not Ready 22, Deviation Error 60. E-stop ID 10 is handled separately and has highest priority.]]>
</Comment>
<Text>
<![CDATA[XIO(EstopActive)[XIC(MX101.LidInterlock) MOV(11,Device[0].InterlockID) ,XIO(MX101.LidInterlock) XIC(MX101.VFDCommsIntlk) MOV(20,Device[0].InterlockID) ,XIO(MX101.LidInterlock) XIO(MX101.VFDCommsIntlk) XIC(MX101.VFDFaultIntlk) MOV(21,Device[0].InterlockID) ,XIO(MX101.LidInterlock) XIO(MX101.VFDCommsIntlk) XIO(MX101.VFDFaultIntlk) XIC(MX101.DevErrorInterlock) MOV(60,Device[0].InterlockID) ,XIO(MX101.LidInterlock) XIO(MX101.VFDCommsIntlk) XIO(MX101.VFDFaultIntlk) XIO(MX101.DevErrorInterlock) MOV(0,Device[0].InterlockID) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[MX101 Device Reset — Resets applicable MX101 interlock causes and commands the VFD to clear resettable drive faults. Final Device Interlock and InterlockID are derived from active causes.]]>
</Comment>
<Text>
<![CDATA[[XIC(Device[0].HMI_DeviceReset) ,XIC(HMI_AllReset) ][OTU(MX101.LidInterlock) ,OTU(MX101.DevErrorInterlock) ,OTU(MX101.VFDCommsIntlk) ,OTU(MX101.VFDFaultIntlk) ,OTE(MX101_UpperHowesVFD:O.ClearFaults) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[MX201 Interlock Summary — Sets Device[1].Interlock while any MX201 interlock cause is active.]]>
</Comment>
<Text>
<![CDATA[[XIC(MX201.LidInterlock) ,XIC(MX201.DevErrorInterlock) ,XIC(MX201.VFDCommsIntlk) ,XIC(MX201.VFDFaultIntlk) ]OTE(Device[1].Interlock);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[MX201 Interlock ID Priority — Assigns the highest-priority active interlock: Lid Safety 11, VFD Communications 20, VFD Fault 21, VFD Not Ready 22, Deviation Error 60. E-stop ID 10 is handled separately and has highest priority.]]>
</Comment>
<Text>
<![CDATA[XIO(EstopActive)[XIC(MX201.LidInterlock) MOV(11,Device[1].InterlockID) ,XIO(MX201.LidInterlock) XIC(MX201.VFDCommsIntlk) MOV(20,Device[1].InterlockID) ,XIO(MX201.LidInterlock) XIO(MX201.VFDCommsIntlk) XIC(MX201.VFDFaultIntlk) MOV(21,Device[1].InterlockID) ,XIO(MX201.LidInterlock) XIO(MX201.VFDCommsIntlk) XIO(MX201.VFDFaultIntlk) XIC(MX201.DevErrorInterlock) MOV(60,Device[1].InterlockID) ,XIO(MX201.LidInterlock) XIO(MX201.VFDCommsIntlk) XIO(MX201.VFDFaultIntlk) XIO(MX201.DevErrorInterlock) MOV(0,Device[1].InterlockID) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[MX201 Device Reset — Resets applicable MX201 interlock causes and commands the VFD to clear resettable drive faults. Final Device Interlock and InterlockID are derived from active causes.]]>
</Comment>
<Text>
<![CDATA[[XIC(Device[1].HMI_DeviceReset) ,XIC(HMI_AllReset) ][OTU(MX201.LidInterlock) ,OTU(MX201.DevErrorInterlock) ,OTU(MX201.VFDCommsIntlk) ,OTU(MX201.VFDFaultIntlk) ,OTE(MX201_LowerHowesVFD:O.ClearFaults) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[GF101 Interlock Summary — Sets Device[2].Interlock while Excess Deviation or any VFD interlock cause is active.]]>
</Comment>
<Text>
<![CDATA[[XIC(GF101.ExcessDevInterlock) ,XIC(GF101.VFDCommsIntlk) ,XIC(GF101.VFDFaultIntlk) ]OTE(Device[2].Interlock);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[GF101 Interlock ID Priority — Assigns the highest-priority active interlock: VFD Communications 20, VFD Fault 21, VFD Not Ready 22, Excess Deviation 60. E-stop ID 10 is handled separately and has highest priority.]]>
</Comment>
<Text>
<![CDATA[XIO(EstopActive)[XIC(GF101.VFDCommsIntlk) MOV(20,Device[2].InterlockID) ,XIO(GF101.VFDCommsIntlk) XIC(GF101.VFDFaultIntlk) MOV(21,Device[2].InterlockID) ,XIO(GF101.VFDCommsIntlk) XIO(GF101.VFDFaultIntlk) XIC(GF101.ExcessDevInterlock) MOV(60,Device[2].InterlockID) ,XIO(GF101.VFDCommsIntlk) XIO(GF101.VFDFaultIntlk) XIO(GF101.ExcessDevInterlock) MOV(0,Device[2].InterlockID) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[GF101 Device Reset — Resets the Excess Deviation interlock, acknowledges the feeder controller, and commands the VFD to clear resettable drive faults. Final Device Interlock and InterlockID are derived from active causes.]]>
</Comment>
<Text>
<![CDATA[[XIC(Device[2].HMI_DeviceReset) ,XIC(HMI_AllReset) ][OTU(GF101.ExcessDevInterlock) ,OTE(GF101_Write_Acknowledge) ,OTU(GF101.VFDCommsIntlk) ,OTU(GF101.VFDFaultIntlk) ,OTE(GF101_Limestone_Feeder:O.ClearFaults) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[GF201 Interlock Summary — Sets Device[3].Interlock while Excess Deviation or any VFD interlock cause is active.]]>
</Comment>
<Text>
<![CDATA[[XIC(GF201.ExcessDevInterlock) ,XIC(GF201.VFDCommsIntlk) ,XIC(GF201.VFDFaultIntlk) ]OTE(Device[3].Interlock);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[GF201 Interlock ID Priority — Assigns the highest-priority active interlock: VFD Communications 20, VFD Fault 21, VFD Not Ready 22, Excess Deviation 60. E-stop ID 10 is handled separately and has highest priority.]]>
</Comment>
<Text>
<![CDATA[XIO(EstopActive)[XIC(GF201.VFDCommsIntlk) MOV(20,Device[3].InterlockID) ,XIO(GF201.VFDCommsIntlk) XIC(GF201.VFDFaultIntlk) MOV(21,Device[3].InterlockID) ,XIO(GF201.VFDCommsIntlk) XIO(GF201.VFDFaultIntlk) XIC(GF201.ExcessDevInterlock) MOV(60,Device[3].InterlockID) ,XIO(GF201.VFDCommsIntlk) XIO(GF201.VFDFaultIntlk) XIO(GF201.ExcessDevInterlock) MOV(0,Device[3].InterlockID) ];]]>
</Text>
</Rung>
