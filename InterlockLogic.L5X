<DataValueMember Name="HighPressureLimit_Int" DataType="DINT" Radix="Decimal" Value="2000"/>
<DataValueMember Name="HighPressureTime" DataType="DINT" Radix="Decimal" Value="1"/>
<StructureMember Name="HighPressureTimer" DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="1000"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</StructureMember>
<DataValueMember Name="HighPressureInterlock" DataType="BOOL" Value="0"/>
<DataValueMember Name="TotalResetCmd" DataType="BOOL" Value="0"/>
<DataValueMember Name="TotalResetDone" DataType="BOOL" Value="0"/>
<DataValueMember Name="TotalResetError" DataType="BOOL" Value="0"/>
<DataValueMember Name="AlarmResetCmd" DataType="BOOL" Value="0"/>
<DataValueMember Name="AlarmResetDone" DataType="BOOL" Value="0"/>
<DataValueMember Name="AlarmResetError" DataType="BOOL" Value="1"/>
<DataValueMember Name="TotalResetAttempts" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="CommOK" DataType="BOOL" Value="1"/>
<DataValueMember Name="DataValid" DataType="BOOL" Value="1"/>
<DataValueMember Name="DataStale" DataType="BOOL" Value="0"/>
<DataValueMember Name="DataAgeMs" DataType="DINT" Radix="Decimal" Value="77"/>
</Structure>
</Data>
</Tag>
<Tag Name="HMI_AllReset" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bit to reset Auto/Man, AutoRun, RecipeRun, TimedRunEnable to 0 from HMI]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="HMI_ProcessReset" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bit to clear the process hold/inteerlock when all other device interlocks are cleared]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="PT103_PV_RAW" TagType="Alias" Radix="Decimal" AliasFor="TC_Remote_IO:1:I.Ch0Data" ExternalAccess="Read/Write">
<Description>
<![CDATA[Raw (unscaled) pressure reading from PT103 - PSI * 100 (range 0 - 108 PSI)]]>
</Description>
</Tag>
<Tag Name="PT104_PV_RAW" TagType="Alias" Radix="Decimal" AliasFor="TC_Remote_IO:1:I.Ch1Data" ExternalAccess="Read/Write">
<Description>
<![CDATA[Raw (unscaled) pressure reading from PT104 - PSI * 100 (range 0 - 108 PSI)]]>
</Description>
</Tag>
<Tag Name="PT105_PV_RAW" TagType="Alias" Radix="Decimal" AliasFor="TC_Remote_IO:1:I.Ch2Data" ExternalAccess="Read/Write">
<Description>
<![CDATA[Raw (unscaled) pressure reading from PT105 - PSI * 100 (range 0 - 108 PSI)]]>
</Description>
</Tag>
<Tag Name="VFD_Panel_Safety_Panel_Etop_OK" TagType="Alias" Radix="Decimal" AliasFor="XS26_VFD_Cabinet_Safety_Controller:I1.Data[1].6" ExternalAccess="Read/Write"/>
<Tag Name="VFD_Panel_Safety_Remote_Estops_OK" TagType="Alias" Radix="Decimal" AliasFor="XS26_VFD_Cabinet_Safety_Controller:I1.Data[1].7" ExternalAccess="Read/Write"/>
</Tags>
<Programs Use="Context">
<Program Use="Context" Name="MainProgram">
<Routines Use="Context">
<Routine Use="Target" Name="InterlockLogic" Type="RLL">
<Description>
<![CDATA[All interlock logic is handled here]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(VFD_Panel_Safety_Panel_Etop_OK) ,XIO(VFD_Panel_Safety_Remote_Estops_OK) ]OTE(EstopActive);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[FT103 High Pressure Interlock — Always interlocks FT103. If FT103 is actively running in Auto, also interlocks the Auto process.]]>
</Comment>
<Text>
<![CDATA[XIC(FT103B.HighPressureInterlock)OTL(Device[7].Interlock);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[FT104 High Pressure Interlock — Always interlocks FT104. If FT104 is actively running in Auto, also interlocks the Auto process.]]>
</Comment>
<Text>
<![CDATA[XIC(FT104B.HighPressureInterlock)OTL(Device[8].Interlock);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[FT105 High Pressure Interlock — Always interlocks FT105. If FT105 is actively running in Auto, also interlocks the Auto process.]]>
</Comment>
<Text>
<![CDATA[XIC(FT105B.HighPressureInterlock)OTL(Device[9].Interlock);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Unlatch  Auto_Run_All_Interlock on HMI reset]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_AllReset)[OTU(Auto_Run_All_Interlock) ,[OTU(Device[7].Interlock) ,[OTU(Device[8].Interlock) ,OTU(Device[9].Interlock) ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Clear FT103 High Pressure Interlock
]]>
</Comment>
<Text>
<![CDATA[XIC(Device[7].HMI_DeviceReset)LEQ(PT103_PV_RAW,FT103B.HighPressureLimit_Int)[OTU(Device[7].Interlock) ,OTU(FT103B.HighPressureInterlock) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Clear FT104 High Pressure Interlock
]]>
</Comment>
<Text>
<![CDATA[XIC(Device[8].HMI_DeviceReset)LEQ(PT104_PV_RAW,FT104B.HighPressureLimit_Int)[OTU(Device[8].Interlock) ,OTU(FT104B.HighPressureInterlock) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Clear FT105 High Pressure Interlock
]]>
</Comment>
<Text>
<![CDATA[XIC(Device[9].HMI_DeviceReset)LEQ(PT105_PV_RAW,FT105B.HighPressureLimit_Int)[OTU(Device[9].Interlock) ,OTU(FT105B.HighPressureInterlock) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(HMI_ProcessReset)XIO(AnyDeviceInterlock)OTU(Auto_Run_All_Interlock);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(Device[0].Interlock) ,XIC(Device[1].Interlock) ,XIC(Device[2].Interlock) ,XIC(Device[3].Interlock) ,XIC(Device[4].Interlock) ,XIC(Device[5].Interlock) ,XIC(Device[6].Interlock) ,XIC(Device[7].Interlock) ,XIC(Device[8].Interlock) ,XIC(Device[9].Interlock) ,XIC(Device[10].Interlock) ,XIC(Device[11].Interlock) ,XIC(Device[12].Interlock) ,XIC(Device[13].Interlock) ]OTE(AnyDeviceInterlock);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(Device[0].AutoMan) XIC(Device[0].Interlock) ,XIC(Device[1].AutoMan) XIC(Device[1].Interlock) ,XIC(Device[2].AutoMan) XIC(Device[2].Interlock) ,XIC(Device[3].AutoMan) XIC(Device[3].Interlock) ,XIC(Device[4].AutoMan) XIC(Device[4].Interlock) ,XIC(Device[5].AutoMan) XIC(Device[5].Interlock) ,XIC(Device[6].AutoMan) XIC(Device[6].Interlock) ,XIC(Device[7].AutoMan) XIC(Device[7].Interlock) ,XIC(Device[8].AutoMan) XIC(Device[8].Interlock) ,XIC(Device[9].AutoMan) XIC(Device[9].Interlock) ,XIC(Device[10].AutoMan) XIC(Device[10].Interlock) ,XIC(Device[11].AutoMan) XIC(Device[11].Interlock) ,XIC(Device[12].AutoMan) XIC(Device[12].Interlock) ,XIC(Device[13].AutoMan) XIC(Device[13].Interlock) ]OTE(AnyAutoDeviceInterlock);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(AnyAutoDeviceInterlock)OTL(Auto_Run_All_Interlock);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
