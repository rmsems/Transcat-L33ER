<DataTypes Use="Context">
<DataType Name="Recipe" Family="NoFamily" Class="User">
<Description>
<![CDATA[Defines the active process recipe, including recipe identification, validity status, and recipe-specific operating parameters for all devices.]]>
</Description>
<Members>
<Member Name="RecipeID" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Numeric identifier for loaded recipe]]>
</Description>
</Member>
<Member Name="ZZZZZZZZZZRecipe1" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/>
<Member Name="Valid" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZRecipe1" BitNumber="0" ExternalAccess="Read/Write">
<Description>
<![CDATA[Indicates a valid recipe/setup has been loaded]]>
</Description>
</Member>
<Member Name="Device" DataType="RecipeDevice" Dimension="20" Radix="NullType" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Recipe settings for each device]]>
</Description>
</Member>
</Members>
<Dependencies>
<Dependency Type="DataType" Name="RecipeDevice"/>
</Dependencies>
</DataType>
<DataType Name="RecipeDevice" Family="NoFamily" Class="User">
<Description>
<![CDATA[Defines recipe-specific operating parameters for one device, including Auto selection, setpoint, start delay, run type, run target, and maximum run time.**]]>
</Description>
<Members>
<Member Name="ZZZZZZZZZZRecipeDevi0" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/>
<Member Name="AutoMode" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZRecipeDevi0" BitNumber="0" ExternalAccess="Read/Write">
<Description>
<![CDATA[Device is selected to participate in Auto]]>
</Description>
</Member>
<Member Name="SP" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Operating setpoint for this device]]>
</Description>
</Member>
<Member Name="StartDelaySec" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Delay after Auto RUNNING before device starts]]>
</Description>
</Member>
<Member Name="RunType" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[0=Open, 1=Timed, 2=Amount]]>
</Description>
</Member>
<Member Name="RunTarget" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Target time or amount, depending on RunType]]>
</Description>
</Member>
<Member Name="MaxRunTimeSec" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Maximum allowed run time regardless of RunType]]>
</Description>
</Member>
</Members>
</DataType>
</DataTypes>
