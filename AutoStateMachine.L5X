</Tag>
<Tag Name="Auto_Run_All_Interlock" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bit to interlock all devices running in Auto]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="AutoRunRequest" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[True when the automatic state machine is in RUNNING and automatic device operation is requested.]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="AutoState" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Current automatic process state. 0=IDLE, 10=ARMED, 20=RUNNING, 30=INTERLOCKED]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="HMI_AutoStart" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Starts all devices in AUTO]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="HMI_AutoStop" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Stops all devices in AUTO]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="HMI_ProcessReset" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bit to clear the process hold/inteerlock when all other device interlocks are cleared]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
</Tags>
<Programs Use="Context">
<Program Use="Context" Name="MainProgram">
<Routines Use="Context">
<Routine Use="Target" Name="AutoStateMachine" Type="RLL">
<Description>
<![CDATA[Logic to Run system in Auto using a state machine]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Auto State Initialization — Forces AutoState to IDLE if the state value is not one of the accepted valued 0, 10, 20, 30]]>
</Comment>
<Text>
<![CDATA[[NEQ(AutoState,0) ,NEQ(AutoState,10) ,NEQ(AutoState,20) ,NEQ(AutoState,30) ]MOV(0,AutoState);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[IDLE to ARMED — Transitions the automatic process from IDLE to ARMED when a valid active recipe is available.]]>
</Comment>
<Text>
<![CDATA[EQU(AutoState,0)XIC(ActiveRecipe.Valid)MOV(10,AutoState);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ARMED to IDLE — Returns the automatic process to IDLE when the active recipe is cleared or becomes invalid.]]>
</Comment>
<Text>
<![CDATA[EQU(AutoState,10)XIO(ActiveRecipe.Valid)MOV(0,AutoState);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ARMED to RUNNING — Starts automatic operation when a valid recipe is armed and the operator presses Auto Start.]]>
</Comment>
<Text>
<![CDATA[EQU(AutoState,10)XIC(ActiveRecipe.Valid)XIC(HMI_AutoStart)MOV(20,AutoState);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[RUNNING to ARMED — Stops automatic operation and returns to ARMED when the operator presses Auto Stop. The active recipe remains loaded.]]>
</Comment>
<Text>
<![CDATA[EQU(AutoState,20)XIC(HMI_AutoStop)MOV(10,AutoState);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[RUNNING to INTERLOCKED — Transitions automatic operation to INTERLOCKED when an active Auto device interlock causes the process-level Auto interlock.]]>
</Comment>
<Text>
<![CDATA[EQU(AutoState,20)XIC(Auto_Run_All_Interlock)MOV(30,AutoState);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[INTERLOCKED to ARMED — Returns automatic operation to ARMED after the process interlock is cleared and the operator acknowledges the condition with Process Reset. A new Auto Start is required to resume operation.]]>
</Comment>
<Text>
<![CDATA[EQU(AutoState,30)XIO(Auto_Run_All_Interlock)XIC(HMI_ProcessReset)MOV(10,AutoState);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Automatic Run Request — Enables automatic device operation while the Auto state machine is in the RUNNING state.]]>
</Comment>
<Text>
<![CDATA[EQU(AutoState,20)OTE(AutoRunRequest);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
